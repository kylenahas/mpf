{{- /* Search index. t=title u=url s=section d=description h=headings
       k=anchor ids (setting and event names on reference pages) b=body text (hand-written pages only, without the
       screen-reader note render-link.html adds to external links) */ -}}
{{- $pages := slice -}}
{{- range site.RegularPages -}}
  {{- $section := "" -}}
  {{- with .Parent }}{{ $section = .Title }}{{ end -}}
  {{- $headings := findRE `<h[23][^>]*>(.*?)</h[23]>` .Content -}}
  {{- $hs := slice -}}
  {{- range first 40 $headings }}{{ $hs = $hs | append (. | plainify | htmlUnescape) }}{{ end -}}
  {{- $ks := slice -}}
  {{- range findRE `id="[^"]+"` .Content -}}
    {{- $id := replaceRE `^id="([^"]+)"$` "$1" . -}}
    {{- if and (ne $id "TableOfContents") (not (in $ks $id)) }}{{ $ks = $ks | append $id }}{{ end -}}
  {{- end -}}
  {{- $d := .Params.summary | default "" | plainify | htmlUnescape | truncate 160 -}}
  {{- $entry := dict "t" .Title "u" .RelPermalink "s" $section "d" $d "h" $hs "k" $ks -}}
  {{- if not .Params.generated -}}
    {{- $entry = merge $entry (dict "b" (replace .Plain " (external site, opens in a new tab)" "" | htmlUnescape | truncate 6000)) -}}
  {{- end -}}
  {{- $pages = $pages | append $entry -}}
{{- end -}}
{{- range site.Sections -}}
  {{- $pages = $pages | append (dict "t" .Title "u" .RelPermalink "s" "Section" "d" "" "h" slice "k" slice) -}}
{{- end -}}
{{- $pages | jsonify -}}
